# ============================================================================
# SysForge Backend — environment variables
# ============================================================================
# Copy this file to .env and adjust values for your local environment.
#   cp .env.example .env
#
# .env is git-ignored and must never be committed.
# ============================================================================

# Application environment: development | production | test
APP_ENV=development

# Host and port the uvicorn server binds to
HOST=127.0.0.1
PORT=8000

# Comma-separated list of origins allowed for CORS.
# The SysForge Vite frontend runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173

# Log level: debug | info | warning | error | critical
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Future — AI service (not used in Phase 2)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Future — persistence (not used in Phase 2, engine is in-memory)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@localhost:5432/sysforge

# ---------------------------------------------------------------------------
# VM safety limits (not enforced in Phase 2 — planned for VM phase)
# ---------------------------------------------------------------------------
# VM_MAX_INSTRUCTIONS=100000
# VM_MAX_MEMORY_WORDS=65536
# VM_MAX_OUTPUT_LINES=1000
# VM_EXECUTION_TIMEOUT_SECONDS=10
